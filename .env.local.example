# Chatbot UI Environment Variables

# ===== Required =====

# Supabase (required for auth and storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== API Keys (at least one required) =====

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
GOOGLE_GEMINI_API_KEY=...

# DeepSeek
DEEPSEEK_API_KEY=sk-...

# Mistral
MISTRAL_API_KEY=...

# Groq
GROQ_API_KEY=...

# Perplexity
PERPLEXITY_API_KEY=pplx-...

# ===== Custom Endpoints (for API proxies / 中转站) =====

# Custom OpenAI-compatible base URL
# Use this to route requests through a proxy/中转站
# Examples:
#   https://api.openai-proxy.com/v1
#   https://your-proxy.example.com/v1
#   http://localhost:11434/v1 (Ollama)
OPENAI_BASE_URL=https://api.openai.com/v1

# Custom Anthropic-compatible base URL (optional)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Custom DeepSeek-compatible base URL (optional)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== Optional =====

# Next.js
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000
